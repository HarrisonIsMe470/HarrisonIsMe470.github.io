# Public identifiers only. Copy to .env for local use and add GitHub Actions variables.
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
# Hosted GoatCounter subdomain only, e.g. my-journal (NOT a URL).
PUBLIC_GOATCOUNTER_CODE=

# Public API origin; must be same-site in production, e.g. https://api.chino520.xyz
PUBLIC_API_URL=http://localhost:8787
