---
import Page from '../layouts/Page.astro';
import { projects } from '../data/projects';
---
<Page title="Projects · Harrison’s Journal" description="Things I’m building and learning along the way."><p class="eyebrow">Learning by making</p><h1>Projects<span class="accent">.</span></h1><p class="lede">Things I’m building and learning along the way.</p>{!projects.length && <div class="notice empty-state"><p class="eyebrow">Room for what comes next</p><h2>More to come.</h2><p>New projects will appear here. In the meantime, explore the journal.</p><a href="/blog/">Read the blog →</a></div>}<div class="projects">{projects.map((project, i) => <article class="project"><div class="project-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div><div>{project.image && <img src={project.image} alt={project.imageAlt || project.name} width="800" height="450" loading="lazy" /> }<p class="eyebrow">{project.status}{project.date && ` · ${project.date}`}</p><h2>{project.name}</h2><p>{project.description}</p><div class="tags">{project.technologies.map(tech => <span>{tech}</span>)}</div><div class="project-links">{project.github && <a href={project.github}>Source on GitHub ↗</a>}{project.demo && <a href={project.demo}>Visit project ↗</a>}</div></div></article>)}</div></Page>
