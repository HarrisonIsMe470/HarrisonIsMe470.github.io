---
import 'katex/dist/katex.min.css';
---
<script>
  async function renderMath() {
  const elements = document.querySelectorAll<HTMLElement>('[data-math="true"]:not([data-math-rendered])');
  if (elements.length) {
    elements.forEach(element => { element.dataset.mathRendered = 'true'; });
    const { default: renderMathInElement } = await import('katex/contrib/auto-render');
    elements.forEach(element => {
      renderMathInElement(element, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true },
      ],
      throwOnError: false,
      trust: false,
      strict: false, // Preserve the original Chinese labels inside formulas.
      // Preserve the literal examples in the Markdown/LaTeX tutorials.
      ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
    }); });
  }
  }
  document.addEventListener('astro:page-load', renderMath);
  void renderMath();
</script>
