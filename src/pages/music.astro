---
import Page from '../layouts/Page.astro';
import { playlist } from '../lib/music';
---
<Page title="Music · Harrison’s Journal" description="A soundtrack for reading, thinking, and slowing down.">
  <p class="eyebrow">The listening room</p><h1>Press play<span class="accent">.</span></h1>
  <p class="lede">A soundtrack for reading, thinking, and slowing down. Pick a track or let shuffle take you somewhere.</p>
  <p class="small">Music keeps playing as you explore the journal.</p>
  <ul class="music-list">{playlist.map((track, index) => <li><span class="track-number">{String(index + 1).padStart(2, '0')}</span><img src={track.cover} width="64" height="64" alt="" loading="lazy" /><div><h2>{track.name}</h2><p>{track.artist}</p></div><button type="button" data-play-track={track.url} aria-pressed="false" aria-label={`Play ${track.name} by ${track.artist}`}>Play ↗</button></li>)}</ul>
  {!playlist.length && <p class="notice">The listening room is quiet for now. Come back soon.</p>}
</Page>
