<section class="comments" data-discussion data-post={Astro.url.pathname} aria-labelledby="comments-title">
 <p class="eyebrow">A little conversation</p><h2 id="comments-title">Join the conversation</h2>
 <p data-status role="status"></p><p><a href="/account/">Log in or create an account</a> to join in.</p>
 <div class="interaction-actions"><button data-vote="1">Like · 0</button><button data-vote="-1">Dislike · 0</button><button data-share>Share post</button></div>
 <form data-comment><label>Your comment<textarea name="body" required maxlength="5000" rows="3"></textarea></label><p data-reply-label></p><button>Post comment</button><button type="button" data-cancel-reply hidden>Cancel reply</button></form>
 <div data-threads></div>
</section>
