---
const meteors = Array.from({ length: 14 }, (_, index) => ({
  left: (index * 29 + 13) % 120,
  top: (index * 17) % 80 - 15,
  delay: -(index * 1.73),
  duration: 8 + (index % 5) * 1.3,
  length: 90 + (index % 4) * 35,
}));
---
<div class="meteor-sky" aria-hidden="true">
  {meteors.map(meteor => <span class="meteor" style={`--x:${meteor.left}%;--y:${meteor.top}%;--delay:${meteor.delay}s;--duration:${meteor.duration}s;--length:${meteor.length}px;`} />)}
</div>
<style>
  .meteor-sky {
    position: fixed;
    inset: 0 0 0 var(--sidebar);
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(1px 1px at 15% 24%, #c5a84066 98%, transparent),
      radial-gradient(1px 1px at 78% 18%, #c5a84077 98%, transparent),
      radial-gradient(1px 1px at 64% 62%, #c5a84055 98%, transparent),
      radial-gradient(1px 1px at 32% 80%, #c5a84044 98%, transparent),
      radial-gradient(ellipse at 85% 5%, #c5a84008, transparent 65%);
  }
  .meteor {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--length);
    height: 1px;
    border-radius: 50%;
    background: linear-gradient(90deg, var(--accent), transparent);
    box-shadow: 0 0 6px #c5a84055;
    opacity: 0;
    animation: meteor-fall var(--duration) var(--delay) linear infinite;
  }
  .meteor::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  @keyframes meteor-fall {
    0% { transform: translate3d(180px, -180px, 0) rotate(-45deg); opacity: 0; }
    5% { opacity: .55; }
    28% { opacity: .35; }
    40%, 100% { transform: translate3d(-65vw, 65vw, 0) rotate(-45deg); opacity: 0; }
  }
  @media (max-width: 760px) {
    .meteor:nth-child(n + 9) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .meteor { animation: none !important; display: none; }
  }
</style>
