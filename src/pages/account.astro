---
import Page from '../layouts/Page.astro';
---
<Page title="Account · Harrison’s Journal">
 <section class="account-panel" data-account><p class="eyebrow">Your place in the journal</p><h1>Your account</h1>
 <p data-status role="status"></p><div data-signed hidden><p data-identity></p><button data-logout>Log out</button></div>
 <form data-auth><label>Email <input name="email" type="email" autocomplete="email" required maxlength="254" /></label><label>Password <input name="password" type="password" autocomplete="current-password" required minlength="12" maxlength="128" /></label><label data-name hidden>Display name <input name="name" autocomplete="nickname" maxlength="80" /></label><button type="submit">Log in</button><button type="button" data-switch>Create an account</button></form>
 <p class="small">Sessions last 15 minutes. Log in again when your session expires.</p></section>
</Page>
