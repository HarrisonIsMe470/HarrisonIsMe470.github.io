---
import legacyProfile from '../data/legacy-profile.json';
import site from '../data/legacy-site.json';
import UpdateHistory from './UpdateHistory.astro';
import history from '../content/pages/legacy-about.html?raw';
---
<section class="about-section" aria-labelledby="links" id={legacyProfile.introAnchor}>
  <h2 id="links">Links</h2>
  <ul class="contact-links">{site.contacts.map(contact => <li><a href={contact.url}>{contact.label}</a></li>)}</ul>
</section>
<UpdateHistory />
<section class="about-section prose legacy-content" aria-label="旧博客待办事项">
  <Fragment set:html={history} />
</section>
