---
import Page from '../layouts/Page.astro';
import { walineAuthURL } from '../lib/waline-login';
import { walineURL } from '../lib/services';
---
<Page title="Account · Harrison’s Journal">
 <section class="account-space" aria-labelledby="account-heading">
  <a class="account-back" href="/blog/">← Back to the journal</a>
  <div class="account-layout">
   <div class="account-story">
    <p class="eyebrow">Harrison’s Journal / Account</p>
    <h1 id="account-heading">A place for<br />your <em>voice.</em></h1>
    <p class="account-intro">A thought, a question, a different perspective.<br />The conversation starts with you.</p>
    <div class="account-orbit" aria-hidden="true">
     <div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div>
     <div class="orbit-core">h<span>.</span></div>
     <span class="orbit-star star-one">✦</span><span class="orbit-star star-two">✧</span><span class="orbit-dot"></span>
     <span class="orbit-caption">A PERSONAL UNIVERSE</span>
    </div>
   </div>
   <div class="account-card" data-waline-account data-server={walineURL}>
    <div class="account-card-top"><span class="account-mark" aria-hidden="true">✦</span><span>THE JOURNAL CLUB</span></div>
    <div data-account-guest>
    <h2>Welcome back<span>.</span></h2>
    <p>Pick up where the conversation left off.</p>
    <button class="account-primary" type="button" data-account-login><span>Log in</span><span aria-hidden="true">↗</span></button>
    <div class="account-divider"><span></span><span>NEW HERE?</span><span></span></div>
    <h3>Make yourself at home.</h3>
    <p>Create an account to leave comments, reply to others, and keep the conversation going.</p>
    <a class="account-secondary" data-account-register target="_blank" href={walineAuthURL(walineURL, 'register').href}><span>Create an account</span><span aria-hidden="true">＋</span></a>
    <p class="account-provider">Your account opens in a separate window. This page stays here.</p>
    <a class="account-help" data-account-forgot target="_blank" href={walineAuthURL(walineURL, 'forgot').href}>Forgot your password?</a>
    </div>
    <div data-account-member hidden>
     <div class="account-avatar"><span data-avatar-fallback aria-hidden="true"></span><img data-account-avatar hidden alt="Your avatar" width="80" height="80" referrerpolicy="no-referrer" /></div>
     <h2 data-account-name></h2>
     <p>You’re part of the conversation.</p>
     <a class="account-primary" href="/blog/"><span>Explore the journal</span><span aria-hidden="true">→</span></a>
     <button type="button" class="account-secondary account-logout" data-account-logout>Log out</button>
    </div>
    <div class="account-window-controls" data-account-window hidden>
     <button type="button" class="account-return" data-account-return aria-label="Close the account window and return to this website">
      <span class="return-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m10 6-6 6 6 6M4 12h16" /></svg></span>
      <span>Return to website</span>
     </button>
    </div>
    <p class="account-status" data-account-status role="status" aria-live="polite"></p>
    <noscript><a href={walineAuthURL(walineURL).href}>Open Waline login</a></noscript>
   </div>
  </div>
 </section>
 <script>import '../scripts/waline-account';</script>
</Page>
<style>
 .account-window-controls { display:flex; justify-content:center; margin-top:1.75rem; padding-top:1rem; border-top:1px solid var(--line); }
 .account-return { display:inline-flex; align-items:center; gap:.65rem; min-height:44px; padding:.45rem .75rem .45rem .3rem; border:0; border-radius:8px; background:transparent; color:var(--muted); font:500 .875rem var(--font); cursor:pointer; transition:color .2s; }
 .return-arrow { display:grid; place-items:center; width:30px; height:30px; color:var(--accent); background:color-mix(in srgb,var(--accent) 8%,transparent); border-radius:50%; transition:transform .2s,background .2s; }
 .account-return:hover { color:var(--ink); }
 .account-return:hover .return-arrow { transform:translateX(-3px); background:color-mix(in srgb,var(--accent) 16%,transparent); }
 .account-return:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
 @media(prefers-reduced-motion:reduce) { .account-return,.return-arrow { transition:none; } .account-return:hover .return-arrow { transform:none; } }
 .account-avatar { position:relative; display:grid; place-items:center; width:80px; height:80px; margin-bottom:1.5rem; background:var(--raised); border:1px solid var(--line); border-radius:50%; color:var(--accent); font-size:2rem; overflow:hidden; }
 .account-avatar img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
 .account-card .account-status { margin:1.25rem 0 0; font-size:.875rem; }
 .account-status:empty { display:none; }
 button.account-primary,button.account-secondary { width:100%; font-family:inherit; cursor:pointer; }
 .account-logout { margin-top:1rem; justify-content:center; }
 .account-space { max-width:1080px; margin:0 auto; padding:1rem 0 3rem; }
 .account-back { display:inline-block; color:var(--muted); font-size:.875rem; text-decoration:none; margin-bottom:3.5rem; }
 .account-back:hover { color:var(--accent); }
 .account-layout { display:grid; grid-template-columns:1.15fr 1fr; gap:clamp(2rem,5vw,5rem); align-items:center; }
 .account-story .eyebrow { font-size:.75rem; letter-spacing:.16em; margin:0 0 1.5rem; }
 .account-story h1 { font-size:clamp(3.25rem,6vw,5.75rem); line-height:1.05; font-weight:500; letter-spacing:-.035em; margin:0 0 1.5rem; }
 .account-story h1 em { color:var(--accent); font-style:normal; }
 .account-intro { color:var(--muted); font-size:1rem; line-height:1.9; }
 .account-orbit { position:relative; width:min(100%,330px); height:240px; margin-top:2rem; }
 .orbit-ring { position:absolute; border:1px solid var(--line); border-radius:50%; left:10%; top:8%; width:78%; height:70%; }
 .ring-one { transform:rotate(-28deg) scaleY(.72); border-color:color-mix(in srgb,var(--accent) 40%,transparent); }
 .ring-two { transform:rotate(38deg) scaleY(.75); }
 .orbit-core { position:absolute; left:35%; top:15%; width:96px; height:96px; display:grid; place-content:center; grid-auto-flow:column; border:1px solid var(--line); background:var(--deep); border-radius:50%; font-family:var(--heading); font-size:3rem; }
 .orbit-core span { color:var(--accent); }
 .orbit-star { position:absolute; color:var(--accent); }
 .star-one { left:11%; top:51%; font-size:2rem; }
 .star-two { right:14%; top:9%; font-size:1.4rem; }
 .orbit-dot { position:absolute; right:9%; top:48%; width:6px; height:6px; border-radius:50%; background:var(--accent); }
 .orbit-caption { position:absolute; bottom:3%; left:0; width:100%; text-align:center; font-size:.7rem; letter-spacing:.25em; color:var(--muted); }
 .account-card { position:relative; padding:clamp(1.5rem,3vw,2.75rem); background:linear-gradient(150deg,color-mix(in srgb,var(--accent) 5%,var(--soft)),var(--deep)); border:1px solid var(--line); border-radius:20px; box-shadow:0 24px 70px #00000018; }
 .account-card:before { content:''; position:absolute; top:-1px; left:15%; right:15%; height:1px; background:linear-gradient(90deg,transparent,var(--accent),transparent); }
 .account-card-top { display:flex; align-items:center; gap:.6rem; font-size:.7rem; letter-spacing:.18em; color:var(--muted); margin-bottom:2rem; }
 .account-mark { color:var(--accent); font-size:1.4rem; }
 .account-card h2 { font-size:clamp(2rem,3vw,2.75rem); margin:0 0 .5rem; line-height:1.2; }
 .account-card h2 span { color:var(--accent); }
 .account-card p { color:var(--muted); line-height:1.75; margin:0 0 1.75rem; font-size:.9375rem; }
 .account-primary,.account-secondary { display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:54px; padding:.8rem 1.1rem; text-decoration:none; border-radius:9px; font-weight:600; font-size:.9375rem; transition:transform .2s, background .2s; }
 .account-primary { color:var(--paper); background:var(--accent); border:1px solid var(--accent); }
 .account-primary:hover { color:var(--paper); background:color-mix(in srgb,var(--accent) 85%,var(--ink)); transform:translateY(-2px); }
 .account-secondary { color:var(--ink); background:var(--soft); border:1px solid var(--line); }
 .account-secondary:hover { color:var(--accent); border-color:var(--accent); transform:translateY(-2px); }
 .account-divider { display:flex; gap:1rem; align-items:center; margin:2rem 0; color:var(--muted); font-size:.65rem; letter-spacing:.15em; }
 .account-divider span:first-child,.account-divider span:last-child { flex:1; height:1px; background:var(--line); }
 .account-card h3 { margin:0 0 .65rem; font-family:var(--font); font-size:1.1rem; font-weight:600; }
 .account-card .account-provider { font-size:.75rem; text-align:center; margin:1.25rem 0 .6rem; }
 .account-help { display:block; text-align:center; color:var(--muted); font-size:.8125rem; text-underline-offset:4px; }
 @media(max-width:800px) { .account-layout { grid-template-columns:1fr; max-width:540px; margin:auto; gap:2rem; } .account-orbit { display:none; } .account-back { margin-bottom:2.5rem; } .account-story h1 { font-size:3.5rem; } }
 @media(prefers-reduced-motion:reduce) { .account-primary,.account-secondary { transition:none; } }
</style>
