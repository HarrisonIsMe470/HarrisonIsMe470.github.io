---
import { type CollectionEntry, render } from 'astro:content';
import { getPosts } from '../../lib/posts';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
// The old repository contains rendered HTML only. Avoid interpreting its code
// examples and TeX a second time as Markdown; normal posts still use render().
const rendered = post.data.legacyHtml ? null : await render(post);
const Content = rendered?.Content;
---

<BlogPost {...post.data}>
	{post.data.legacyHtml ? <Fragment set:html={post.body ?? ''} /> : Content && <Content />}
</BlogPost>
